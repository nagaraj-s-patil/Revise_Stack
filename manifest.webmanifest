    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./#today", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Progress", "url": "./#progress", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
