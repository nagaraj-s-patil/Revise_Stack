{
  "name": "revise-stack",
  "version": "2.0.0",
  "description": "Installable revision tracker for a Java Full Stack syllabus. Front end only, data in localStorage.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test test/*.test.js",
    "precache": "node tools/update-precache.mjs",
    "syllabus": "node tools/generate-syllabus.mjs",
    "icons": "python3 tools/make-icons.py"
  }
}
